{
  "manifestVersion": 5,
  "id": "com.autocut.panel",
  "name": "AutoCut",
  "version": "0.4.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "autocutPanel",
      "label": { "default": "AutoCut" },
      "description": {
        "default": "Сборка рыбы: интервью, дайджест, сюжет"
      },
      "minimumSize": { "width": 320, "height": 420 },
      "maximumSize": { "width": 1200, "height": 1200 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 420, "height": 700 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "extensions": [".bat"]
    },
    "enableAlerts": true
  }
}